# Real AI backends are optional. Without a key, a cloud model in the LLM node
# answers with a mock reply, so chat graphs still run. Ollama models need a
# running Ollama instead, and TTS and STT nodes need their provider's key.
# Copy this file to .env and fill in the keys for the providers you use (they
# can also be set in the editor's Connections window).

# xAI (Grok chat, TTS, STT)
XAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Fish Audio (TTS, STT)
FISH_API_KEY=

# ElevenLabs (TTS, STT)
ELEVENLABS_API_KEY=

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
